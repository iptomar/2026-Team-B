											"$ref": "#/components/schemas/RoleResponse"
										},
										{
											"properties": {
												"message": {
													"type": "string"
												}
											},
											"required": [
												"message"
											],
											"type": "object"
										}
									]
								}
							}
						}
					},
					"409": {
						"description": "Role already exists"
					}
				},
				"description": "add a new role.",
				"tags": [
					"Roles"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RoleCreationParams"
							}
						}
					}
				}
			}
		},
